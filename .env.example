# ==========================================
# SPLITWISE CONFIGURATION
# Register an app at: https://secure.splitwise.com/apps
# ==========================================
SPLITWISE_CONSUMER_KEY=your_consumer_key_here
SPLITWISE_CONSUMER_SECRET=your_consumer_secret_here
SPLITWISE_API_KEY=your_api_key_here
SPLITWISE_GROUP_ID=0

# ==========================================
# AI CONFIGURATION (Uses minimal tokens)
# Choose either 'openai' (gpt-4o-mini) or 'gemini' (gemini-2.5-flash)
# ==========================================
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# AUTOMATED REMINDER SETTINGS
# ==========================================
REMINDER_INTERVAL_DAYS=7
AUTO_REMIND_ENABLED=false
DRY_RUN=true
